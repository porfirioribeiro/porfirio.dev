{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porfirio-dev",
  "account_id": "0bf87e76fffe7554f4cbc045738e5dd5",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
  },
  "routes": [{ "pattern": "porfirio.dev/*", "zone_name": "porfirio.dev" }],
  // Worker Previews: `previews` block is required by `npx wrangler preview`
  // (empty = previews use top-level settings). `preview_urls` gives Previews a
  // public <preview>-porfirio-dev...workers.dev URL; it defaults to false and
  // must be applied via a deploy.
  "preview_urls": true,
  "previews": {},
  // Observability: sync with dashboard settings (Workers Logs + Traces).
  // Note: dashboard suggests "issue_detection"; wrangler's schema uses "issues".
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issues": {
      "enabled": true,
    },
  },
}
